FROM python:3.13-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends chromium ffmpeg fonts-nanum fonts-dejavu-core \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -m -s /bin/bash appuser \
    && mkdir -p /data /app \
    && chown -R appuser:appuser /data /app

WORKDIR /app

COPY --chown=appuser:appuser 01_app /app/01_app
COPY --chown=appuser:appuser config /app/config
COPY --chown=appuser:appuser migrations /app/migrations
COPY --chown=appuser:appuser contracts /app/contracts
COPY --chown=appuser:appuser prompts /app/prompts
COPY --chown=appuser:appuser tools/unified_content_prompt_harness.py /app/tools/unified_content_prompt_harness.py
COPY --chown=appuser:appuser tools/validate_unified_content.py /app/tools/validate_unified_content.py
COPY --chown=appuser:appuser tools/validate_json_schema.py /app/tools/validate_json_schema.py
COPY --chown=appuser:appuser 02_media/video/P1_merged.mp4 /app/02_media/video/P1_merged.mp4
COPY --chown=appuser:appuser 02_media/images/scenes/scene_*.webp /app/02_media/images/scenes/
COPY --chown=appuser:appuser 02_media/music /app/02_media/music
COPY --chown=appuser:appuser 02_media/narration /app/02_media/narration

ENV PYTHONPATH=/app:/app/01_app
ENV DATA_DIR=/data
ENV SQLITE_PATH=/data/tc.sqlite
ENV FINAL_EXPORT_QUEUE_PATH=/data/tc.sqlite
ENV FINAL_EXPORT_LEASE_SECONDS=300
ENV FINAL_EXPORT_HEARTBEAT_SECONDS=30
ENV FINAL_EXPORT_POLL_SECONDS=2
ENV P1_NO_BROWSER=1
ENV RENDER_PRESET=ultrafast
ENV FFMPEG_THREADS=1
ENV KLING_ARTIFACT_DIR=/data/generated/kling

USER appuser

CMD ["python", "01_app/final_export_worker.py"]
