FROM python:3.13-slim

RUN groupadd -g 10001 appuser \
    && useradd -u 10001 -g appuser -m -s /bin/bash appuser \
    && mkdir -p /data /app \
    && chown -R appuser:appuser /data /app

WORKDIR /app

COPY --chown=appuser:appuser 01_app /app/01_app
COPY --chown=appuser:appuser config /app/config
COPY --chown=appuser:appuser migrations /app/migrations
COPY --chown=appuser:appuser contracts /app/contracts
COPY --chown=appuser:appuser tools/validate_json_schema.py /app/tools/validate_json_schema.py

ENV PYTHONPATH=/app:/app/01_app
ENV DATA_DIR=/data
ENV SQLITE_PATH=/data/tc.sqlite
ENV WORKER_HEALTH_PATH=/data/worker_health.json
ENV WORKER_JOB_STORE_PATH=/data/worker_jobs.json
ENV AUTOMATION_API_URL=http://api:10000
ENV AUTOMATION_IMAGE_MODEL=gpt-image-2.5-sunburst
ENV WORKER_HEARTBEAT_INTERVAL_SECONDS=15
ENV WORKER_IDLE_POLL_SECONDS=5
ENV AUTOMATION_API_TIMEOUT_SECONDS=7200
ENV AUTOMATION_API_RETRY_COUNT=3
ENV AUTOMATION_API_RETRY_BACKOFF_SECONDS=2
ENV AUTOMATION_HEARTBEAT_INTERVAL_SECONDS=15
ENV AUTOMATION_I2V_POLL_INTERVAL_SECONDS=5
ENV AUTOMATION_I2V_TIMEOUT_SECONDS=3600
ENV WORKER_JOB_LEASE_SECONDS=300
ENV AUTOMATION_RENDER_TYPE=editorial
ENV AUTOMATION_RENDER_MUSIC=satie
ENV AUTOMATION_RENDER_VOLUME=0.5
ENV AUTOMATION_RENDER_PAN_X=0.5

USER appuser

CMD ["python", "01_app/worker.py"]
