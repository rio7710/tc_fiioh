{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["decision", "reason", "content_preserved", "protected_phrases", "revised_motion_prompt"],
  "properties": {
    "decision": {"enum": ["keep", "revise"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 500},
    "content_preserved": {"type": "boolean"},
    "protected_phrases": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "minLength": 4, "maxLength": 300}
    },
    "revised_motion_prompt": {"type": "string", "maxLength": 1200}
  }
}
